# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co/
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── OpenAI (embeddings + agente) ──────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── DeepSeek (opcional — si se usa como LLM alternativo) ─────────────────────
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=your-deepseek-api-key

# ── App ───────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
FRONTEND_URL=http://localhost:5173
MAX_AGENT_ITERATIONS=5

# ── RAG tuning (valores por defecto recomendados) ─────────────────────────────
RAG_MATCH_THRESHOLD=0.30
RAG_FEEDBACK_WEIGHT=0.15
RAG_RATING_WEIGHT=0.10
RAG_POSITIVE_FEEDBACK_WEIGHT=0.12
