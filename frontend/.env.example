# ── Supabase ──────────────────────────────────────────────────────────────────
# Consigue estos valores en: https://supabase.com/dashboard → tu proyecto → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Estas variables sin VITE_ las usa el server-side (SSR de TanStack Start)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# ── Backend FastAPI ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Mock mode ─────────────────────────────────────────────────────────────────
# true  → usa datos falsos, funciona sin backend (ideal para desarrollo de UI)
# false → se conecta al FastAPI real
VITE_USE_MOCK=false
